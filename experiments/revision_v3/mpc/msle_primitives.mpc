"""Corrected primitive agreement and secure-shuffle tests; opens pass bits.

Inputs: P0 full-field test values; each party 9 key contributions; P0
expected locator cipher values and expected 64-bit mask chunks for key 1.
The explicit public prime must be passed to compile.py with -P.
"""
import json
from pathlib import Path
from Compiler.library import tree_reduce

cfg = json.loads(Path("msle_parameters.json").read_text())
PRIME = int(cfg["prime"])
CONSTANTS = list(map(int, cfg["round_constants"]))
N = int(program.args[1])
program.set_bit_length(64)
program.set_security(80)
program.use_edabit(True)


def permute(x, key):
    for constant in CONSTANTS:
        x = (x + key + constant) ** 3
    return x + key


def field_zero(x):
    return 1 - x ** (PRIME - 1)


def product(xs):
    return tree_reduce(lambda a, b: a * b, xs)


values = sint.Array(N)
values.input_from(0)
keys = [sint(0) for _ in range(9)]
for party in range(5):
    for j in range(9):
        keys[j] += sint.get_input_from(party)
expected = sint.Array(N)
expected.input_from(0)
expected_bits = sint.Array(64 * N)
expected_bits.input_from(0)

start_timer(1)
cipher = permute(values.get_vector(), keys[0])
enc_ok_vec = field_zero(cipher - expected.get_vector())
enc_ok = product([enc_ok_vec[i] for i in range(N)])
word = permute(values.get_vector(), keys[1])
canonical_bits = word.bit_decompose(128)
bit_ok_terms = []
for b in range(64):
    want = expected_bits.get_vector(base=b * N, size=N)
    mismatch = canonical_bits[b] + want - 2 * canonical_bits[b] * want
    bit_ok_terms.extend([1 - mismatch[i] for i in range(N)])
bit_ok = product(bit_ok_terms)
# The full-field equality test must reject nonzero multiples of 2^64.
zero_checks = [field_zero(sint(0)), 1-field_zero(sint(1 << 64)),
               1-field_zero(sint(PRIME-1)), 1-field_zero(sint(1 << 127))]
eq_ok = product(zero_checks)
stop_timer(1)

start_timer(2)
pairs = sint.Array(2 * N)
for i in range(N):
    pairs[2*i] = i + 1
    pairs[2*i+1] = 3 * (i + 1) + 7
shuffled = pairs.get_vector().secure_shuffle(unit_size=2)
pair_ok = product([field_zero(shuffled[2*i+1] - 3*shuffled[2*i] - 7) for i in range(N)])
challenge = sint.get_random().reveal()
multiset_ok = field_zero(product([challenge-shuffled[2*i] for i in range(N)])
                         - product([challenge-(i+1) for i in range(N)]))
stop_timer(2)

print_ln("MSLE_PRIMITIVES n=%s cipher_ok=%s mask_bits_ok=%s full_field_eq_ok=%s shuffle_rows_ok=%s shuffle_multiset_ok=%s",
         N, enc_ok.reveal(), bit_ok.reveal(), eq_ok.reveal(), pair_ok.reveal(), multiset_ok.reveal())
