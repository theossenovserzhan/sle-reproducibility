"""M-SLE revision system, explicit-prime arithmetic, fixed-scan backend.

Args: N D B C MODE PROTECTION TRANSITION MAINTENANCE FAULT SRC DST DIAG
MODE 0=transition+fresh query, 1=transition only, 2=standalone query.
PROTECTION 0=masked state, 1=shared raw-root ablation.
TRANSITION 0=direct locator PRP, 1=oblivious radix sort/merge translation.
MAINTENANCE 1=secret DB row shuffle + fresh zero sharings of all state.
FAULT 0=none, 1=omission,2=duplication,3=misplacement,4=locator corruption,
      5=wrong index key,6=stale index entry,7=template bit flip,8=stale template.
DIAG 1 adds independent oracle inputs and opens correctness bits only.

Persistent state and query execution use only public-size fixed scans. The
private index is maintained and checked but the secure query is exhaustive.
No indexed-query speedup or ORAM implementation is claimed by this backend.
"""
import json
from pathlib import Path
from Compiler import sorting
from Compiler.library import tree_reduce

cfg = json.loads(Path("msle_parameters.json").read_text())
PRIME = int(cfg["prime"])
CONSTANTS = list(map(int, cfg["round_constants"]))
N, D, B, C, MODE, PROTECTION, TRANSITION, MAINTENANCE, FAULT, SRC, DST, DIAG = map(int, program.args[1:])
assert N >= 2 and D % 64 == 0 and D % B == 0
assert 0 <= MODE <= 2 and PROTECTION in (0,1) and TRANSITION in (0,1)
BLOCKS, VALUES = D // B, 2 ** B
M = BLOCKS * VALUES * C
ROW_WIDTH = D + 3
DB_SIZE = N * ROW_WIDTH
STATE_SIZE = DB_SIZE + 2*M + 9
program.set_bit_length(64)
program.set_security(80)
program.use_edabit(True)


def permute(x, key):
    for constant in CONSTANTS:
        x = (x + key + constant) ** 3
    return x + key


def field_zero(x):
    return 1 - x ** (PRIME-1)


def xor(a,b):
    return a+b-2*a*b


def product_vector(vector):
    width = len(vector)
    padded = 1 << (width-1).bit_length()
    array = sint.Array(padded)
    array.assign_all(1)
    array.assign_vector(vector)
    while padded > 1:
        current = array.get_vector(size=padded)
        half = padded // 2
        left = current.get_vector(size=half, skip=2)
        right = current.get_vector(base=1, size=half, skip=2)
        array.assign_vector(left*right)
        padded = half
    return array[0]


def mask_array(keys, locators):
    result = sint.Array(N*D)
    if PROTECTION:
        result.assign_all(0)
    else:
        for chunk in range(D//64):
            word = permute(locators.get_vector(), keys[chunk+1])
            bits = word.bit_decompose(128)
            for bit in range(64):
                result.assign_vector(bits[bit], base=(64*chunk+bit)*N)
    return result


def radix_translate(old_db, old_index, valid, new_db):
    length = N+M
    records = sint.Matrix(length, 6)
    keys = sint.Array(length)
    # Stable sort preserves DB-before-index for equal old locators. No
    # multiplication by 2 packs a 129-bit key into a 128-bit field.
    @for_range(N)
    def _(i):
        records[i][0] = old_db[i]
        records[i][1] = new_db[i]
        records[i][2] = 1
        records[i][3] = 0
        records[i][4] = M+i
        records[i][5] = 0
        keys[i] = old_db[i]
    @for_range(M)
    def _(i):
        row = N+i
        records[row][0] = old_index[i]
        records[row][1] = 0
        records[row][2] = 0
        records[row][3] = 1
        records[row][4] = i
        records[row][5] = valid[i]
        keys[row] = old_index[i]
    sorting.radix_sort(keys, records, n_bits=128, signed=False)
    sorted_keys = records.get_column(0)
    boundaries = sint.Array(length)
    boundaries[0] = 1
    adjacent = sorted_keys.get_vector(base=1,size=length-1) - sorted_keys.get_vector(size=length-1)
    boundaries.assign_vector(1-field_zero(adjacent), base=1)
    group = boundaries.get_vector().prefix_sum()
    carried = records.get_column(1)
    has_source = records.get_column(2)
    stride = 1
    while stride < length:
        count = length-stride
        same = group.get_vector(base=stride,size=count) == group.get_vector(size=count)
        left_has = has_source.get_vector(size=count)
        right_has = has_source.get_vector(base=stride,size=count)
        take = same*left_has*(1-right_has)
        new_carried = sint.Array(length)
        new_has = sint.Array(length)
        new_carried.assign_vector(carried.get_vector(size=stride))
        new_has.assign_vector(has_source.get_vector(size=stride))
        new_carried.assign_vector(take.if_else(carried.get_vector(size=count),carried.get_vector(base=stride,size=count)),base=stride)
        new_has.assign_vector(right_has+take,base=stride)
        carried,has_source = new_carried.get_vector(),new_has.get_vector()
        stride *= 2
    index_rows, validity = records.get_column(3),records.get_column(5)
    join_ok = product_vector(1-index_rows*validity*(1-has_source))
    random_dummy = sint.get_random(size=length)
    records.set_column(1, validity.if_else(carried,random_dummy))
    restore = sint.Array(length)
    restore.assign_vector(records.get_column(4))
    sorting.radix_sort(restore,records,n_bits=(length-1).bit_length(),signed=False)
    result = sint.Array(M)
    result.assign_vector(records.get_column(1).get_vector(size=M))
    return result,join_ok


start_timer(30)
old_locs = sint.Array(N)
old_c = sint.Array(N*D)
old_locs.input_from(0)
old_c.input_from(0)
if MODE != 2:
    old_index, valid = sint.Array(M),sint.Array(M)
    old_index.input_from(0)
    valid.input_from(0)
labels,ties = sint.Array(N),sint.Array(N)
labels.input_from(0)
ties.input_from(0)
old_keys = [sint(0) for _ in range(9)]
new_keys = [sint(0) for _ in range(9)]
for party in range(5):
    for j in range(9):
        old_keys[j] += sint.get_input_from(party)
    if MODE != 2:
        for j in range(9):
            new_keys[j] += sint.get_input_from(party)
if MODE != 1:
    probe = sint.Array(D)
    probe.input_from(1)
    threshold = sint.get_input_from(1)
if DIAG:
    if MODE != 2:
        oracle_locs,oracle_c = sint.Array(N),sint.Array(N*D)
        oracle_locs.input_from(0)
        oracle_c.input_from(0)
    oracle_label = sint.get_input_from(0)
    oracle_distance = sint.get_input_from(0)
    oracle_relation = sint.get_input_from(0)

current_locs,current_c,current_labels,current_ties = old_locs,old_c,labels,ties
current_keys = old_keys
relation_ok = sint(1)
state_ok = sint(1)

if MODE != 2:
    start_timer(11)
    start_timer(12)
    next_locs = sint.Array(N)
    next_locs.assign_vector(permute(old_locs.get_vector(),new_keys[0]))
    if TRANSITION:
        next_index,join_ok = radix_translate(old_locs,old_index,valid,next_locs)
    else:
        next_index = sint.Array(M)
        next_index.assign_vector(permute(old_index.get_vector(),new_keys[0]))
        join_ok = sint(1)
    next_valid = sint.Array(M)
    next_valid.assign_vector(valid.get_vector())
    stop_timer(12)

    start_timer(13)
    old_mask,new_mask = mask_array(old_keys,old_locs),mask_array(new_keys,next_locs)
    transient_roots = xor(old_c.get_vector(),old_mask.get_vector())
    expected_c = xor(transient_roots,new_mask.get_vector())
    candidate_c = sint.Array(N*D)
    candidate_c.assign_vector(expected_c)
    stop_timer(13)

    if FAULT == 1:
        next_valid[SRC] = 0
    elif FAULT == 2:
        next_index[DST],next_valid[DST] = next_index[SRC],sint(1)
    elif FAULT == 3:
        next_index[DST],next_valid[DST],next_valid[SRC] = next_index[SRC],sint(1),sint(0)
    elif FAULT == 4:
        next_index[SRC] += 1
    elif FAULT == 5:
        next_index.assign_vector(permute(old_index.get_vector(),new_keys[0]+1))
    elif FAULT == 6:
        next_index[SRC] = old_index[SRC]
    elif FAULT == 7:
        candidate_c[0] = 1-candidate_c[0]
    elif FAULT == 8:
        for bit in range(D):
            candidate_c[bit*N] = old_c[bit*N]

    start_timer(14)
    template_ok = product_vector(1-xor(candidate_c.get_vector(),expected_c))
    # Expected relation is derived from the PROPOSED protected state, binding
    # templates to index rows rather than checking only the previous roots.
    proposed_roots = xor(candidate_c.get_vector(),new_mask.get_vector())
    index_positions = regint.inc(M)
    slot_block = cint(index_positions // (C*VALUES))
    slot_bucket = cint((index_positions // C) % VALUES)
    fingerprints = []
    for check in range(2):
        r,alpha,beta = [sint.get_random().reveal() for _ in range(3)]
        expected_factors = sint.Array(N*BLOCKS)
        for block in range(BLOCKS):
            bucket = sint(0,size=N)
            for bit in range(B):
                bucket += proposed_roots.get_vector(base=(block*B+bit)*N,size=N) * (2**bit)
            expected_factors.assign_vector(r-next_locs.get_vector()-alpha*block-beta*bucket,base=block*N)
        factor = r-next_index.get_vector()-alpha*slot_block-beta*slot_bucket
        actual_factors = next_valid.get_vector()*(factor-1)+1
        fingerprints.append(field_zero(product_vector(expected_factors.get_vector())-product_vector(actual_factors)))
    relation_ok = template_ok*join_ok*fingerprints[0]*fingerprints[1]
    stop_timer(14)

    start_timer(15)
    current_locs,current_c = sint.Array(N),sint.Array(N*D)
    current_locs.assign_vector(relation_ok.if_else(next_locs.get_vector(),old_locs.get_vector()))
    current_c.assign_vector(relation_ok.if_else(candidate_c.get_vector(),old_c.get_vector()))
    current_index,current_valid = sint.Array(M),sint.Array(M)
    current_index.assign_vector(relation_ok.if_else(next_index.get_vector(),old_index.get_vector()))
    current_valid.assign_vector(relation_ok.if_else(next_valid.get_vector(),valid.get_vector()))
    current_keys = [relation_ok.if_else(new_keys[j],old_keys[j]) for j in range(9)]
    if DIAG:
        want_locs = oracle_relation.if_else(oracle_locs.get_vector(),old_locs.get_vector())
        want_c = oracle_relation.if_else(oracle_c.get_vector(),old_c.get_vector())
        state_ok = product_vector(field_zero(current_locs.get_vector()-want_locs)) * product_vector(1-xor(current_c.get_vector(),want_c))
        if FAULT:
            state_ok *= product_vector(field_zero(current_index.get_vector()-old_index.get_vector()))
            state_ok *= product_vector(1-xor(current_valid.get_vector(),valid.get_vector()))
            state_ok *= tree_reduce(lambda a,b:a*b,[field_zero(current_keys[j]-old_keys[j]) for j in range(9)])
    stop_timer(15)

    start_timer(16)
    db = sint.Matrix(N,ROW_WIDTH)
    db.set_column(0,current_locs.get_vector())
    db.set_column(1,labels.get_vector())
    db.set_column(2,ties.get_vector())
    for bit in range(D):
        db.set_column(3+bit,current_c.get_vector(base=bit*N,size=N))
    if MAINTENANCE:
        db.assign_vector(db.get_vector().secure_shuffle(unit_size=ROW_WIDTH))
    state = sint.Array(STATE_SIZE)
    state.assign_vector(db.get_vector())
    state.assign_vector(current_index.get_vector(),base=DB_SIZE)
    state.assign_vector(current_valid.get_vector(),base=DB_SIZE+M)
    for j in range(9):
        state[DB_SIZE+2*M+j] = current_keys[j]
    if MAINTENANCE:
        # Each honest party privately inputs a freshly randomized sharing of
        # zero. Sum of these zero polynomials refreshes every state share.
        refreshed = state.get_vector()
        for party in range(5):
            zero_sharing = sint.Array(STATE_SIZE)
            zero_sharing.input_from(party)
            refreshed += zero_sharing.get_vector()
        state.assign_vector(refreshed)
    # One complete logical state bundle. Durable crash-atomic publication is
    # handled by an epoch manifest outside the circuit, not assumed from this
    # write instruction alone.
    state.write_to_file(0)
    db.assign_vector(state.get_vector(size=DB_SIZE))
    current_locs.assign_vector(db.get_column(0))
    current_labels,current_ties = db.get_column(1),db.get_column(2)
    for bit in range(D):
        current_c.assign_vector(db.get_column(3+bit),base=bit*N)
    current_keys = [state[DB_SIZE+2*M+j] for j in range(9)]
    stop_timer(16)
    stop_timer(11)

query_ok = sint(1)
decision = sint(-1)
accepted = sint(0)
if MODE != 1:
    start_timer(20)
    start_timer(21)
    # Standalone query generates masks from persistent state; it does not
    # reuse the old/new masks computed during a preceding transition.
    query_mask = mask_array(current_keys,current_locs)
    stop_timer(21)
    start_timer(22)
    distances = sint(0,size=N)
    for bit in range(D):
        protected_probe = xor(probe[bit],query_mask.get_vector(base=bit*N,size=N))
        distances += xor(current_c.get_vector(base=bit*N,size=N),protected_probe)
    def best(left,right):
        better = (right[0]<left[0]) + (right[0]==left[0])*(right[2]<left[2])
        return tuple(better.if_else(r,l) for l,r in zip(left,right))
    distance,label,tie = tree_reduce(best,[(distances[i],current_labels[i],current_ties[i]) for i in range(N)])
    accepted = distance <= threshold
    decision = accepted.if_else(label,sint(-1))
    if DIAG:
        query_ok = field_zero(decision-oracle_label) * (distance==oracle_distance)
    stop_timer(22)
    stop_timer(20)
if DIAG:
    state_ok *= (relation_ok==oracle_relation)
stop_timer(30)
print_ln("MSLE_SYSTEM n=%s d=%s mode=%s protection=%s transition=%s maintenance=%s fault=%s relation=%s accepted=%s identity=%s state_ok=%s query_ok=%s",
         N,D,MODE,PROTECTION,TRANSITION,MAINTENANCE,FAULT,relation_ok.reveal(),accepted.reveal(),decision.reveal(),state_ok.reveal(),query_ok.reveal())
